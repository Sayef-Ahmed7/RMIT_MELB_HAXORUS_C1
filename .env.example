APP_PORT=3000
PLC_PORT=4000
TIDE_PORT=5000

# tidecloak: real TideCloak login, roles and admin change requests (run `npm run tidecloak:bootstrap` first)
# sim:       offline simulator, used by `npm test`
TIDE_MODE=sim

# --- Only for `npm run tidecloak:bootstrap` (local Docker TideCloak) ---
# Master admin of the local TideCloak container. Pick a strong value; the bootstrap refuses to run
# without one, and the app never uses it.
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=
# The realm is licensed to this address under Tide's Terms & Conditions (https://tide.org/legal).
# Only the person who owns the deployment may fill these in, after reading the terms.
# TIDE_LICENSE_EMAIL=
# TIDE_TERMS_ACCEPTED=

# Optional: Claude writes the plain-English risk explanation. Without a key, rule templates are used.
# The AI is advisory only; it never approves anything.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
